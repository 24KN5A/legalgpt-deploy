# ==========================================
# LegalGPT MERN Production Environment Config
# ==========================================

PORT=8000
NODE_ENV=production

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/legalgpt?retryWrites=true&w=majority

# JWT Security
JWT_SECRET=legalgpt_production_super_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=7d

# LegalGPT Neural AI Engine API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-flash-lite-latest

# Nodemailer / Email OTP Config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="LegalGPT Support <no-reply@legalgpt.com>"

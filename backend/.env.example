# ==========================================
# LegalGPT Backend Configuration (.env)
# ==========================================

ENVIRONMENT=development
DEBUG=true

# ==========================================
# SMS Gateway Settings
# ==========================================
# 1. Mock (Default for local development - free, logs OTP to UI and backend terminal)
SMS_PROVIDER=mock

# 2. Fast2SMS (Instant setup & free trial credits for Indian mobile numbers)
# Sign up at: https://www.fast2sms.com -> Dev API -> Copy API Authorization Key
# SMS_PROVIDER=fast2sms
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# 3. Twilio (Global SMS)
# Sign up at: https://www.twilio.com
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
